save_bm_epidemics <- function(time_series,
dates        = NULL,
test_split   = 0.20,
cumulative   = FALSE) {
# ----------------------------------------------------------
# 1.  Pull the numeric vector & date index
# ----------------------------------------------------------
# If it's a ts/xts/zoo, coredata() pulls the numbers
y  <- as.numeric(time_series)
# ---- dates handling ----
if (is.null(dates)) {
# try to grab index from a zoo/xts/ts object
if (!is.null(time(time_series))) {
dates <- as.Date(time(time_series))
} else {
# fallback: weekly sequence ending at today
dates <- seq.Date(Sys.Date() - 7 * (length(y) - 1),
by = "week", length.out = length(y))
}
}
if (length(dates) != length(y))
stop("Length of 'dates' must equal length of 'time_series'")
# ----------------------------------------------------------
# 2.  Train-test split index (80/20 by default)
# ----------------------------------------------------------
split_idx <- floor((1 - test_split) * length(y))
train_y <- y[1:split_idx]
# ----------------------------------------------------------
# 3.  Fit Bass Model (BM) to training slice
# ----------------------------------------------------------
bm_mod <- BM(train_y, display = FALSE)
# ----------------------------------------------------------
# 4.  Forecast for the full horizon (same length as y)
# ----------------------------------------------------------
full_forecast <- predict(bm_mod, newx = seq_along(y))
# Instantaneous vs cumulative
fitted_vals <- if (cumulative) {
full_forecast                       # cumulative
} else {
make.instantaneous(full_forecast)   # flows
}
# ----------------------------------------------------------
# 5.  Output tidy data-frame
# ----------------------------------------------------------
out <- data.frame(
date   = dates,
fitted = fitted_vals
)
return(out)
}
