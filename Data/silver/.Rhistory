# Define the series list as data frames
series_list <- list(
Dengue = df_dengue,
Zika = df_zika,
Chicungunya = df_chic,
Varicela = df_var
)
# Find the full range of dates
all_dates <- Reduce(union, lapply(series_list, function(df) df$Date))
# Create a dataframe with all dates
all_dates_df <- data.frame(Date = all_dates)
# Initialize an empty list to store the results
results_list <- list()
# Loop over each series in the series_list
for (name in names(series_list)) {
df <- series_list[[name]]
series <- df$Value
dates <- df$Date
# Call the save_bm_epidemics_test function
result_df <- save_bm_epidemics_test(series, dates, test_split = 0.2, cumulative = FALSE)
# Rename the columns to include the series name
colnames(result_df)[2:3] <- paste0(colnames(result_df)[2:3], "_", name)
# Merge the result with the all_dates_df
merged_df <- all_dates_df %>%
left_join(result_df, by = "Date")
# Store the merged dataframe in the results list
results_list[[name]] <- merged_df
}
