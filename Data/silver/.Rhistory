save_ggm_r_model_test <- function(country_name, df, test_split = 0.2, cumulative = TRUE) {
# Filter data for the specific country
df_country <- df %>% filter(country == country_name)
# Get GGM residuals and test data (modified to work with our structure)
ggm_results <- ggm_residuals_test(country_name, df, test_split = test_split)
df_train <- ggm_results$train_residuals
df_test <- ggm_results$test_data
# Fit ARIMA model with GGM fitted values as regressor
arima_model <- auto.arima(df_train$Cases, xreg = df_train$Fitted)
# Forecast for entire period (not just test set)
full_forecast <- forecast(arima_model,
h = nrow(df_country),
xreg = df_country$Fitted)$mean
# Prepare output dataframe
df_plot <- data.frame(
Time = df_country$date,  # Use actual dates
Actual = if(cumulative) df_country$cumulative_cases else df_country$new_cases,
Fitted = full_forecast,  # Full forecast values
Country = country_name
)
# Add train/test indicator
split_index <- floor((1 - test_split) * nrow(df_country))
df_plot$Period <- ifelse(seq_len(nrow(df_country)) <= split_index, "Train", "Test")
return(df_plot)
}
