df <- save_bm_epidemics(ts_obj, cumulative = TRUE)   # <- patched function
df %>%
mutate(
# snap every date to ISO-week Monday
date = floor_date(date, unit = "week", week_start = 1),
disease = name,
cases   = fitted
) %>%
select(date, disease, cases)
}
