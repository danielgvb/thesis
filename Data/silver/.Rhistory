# 1.  Pull the numeric vector & date index
# If it's a ts/xts/zoo, coredata() pulls the numbers
y  <- as.numeric(time_series)
# ---- dates handling
if (is.null(dates)) {
# try to grab index from a zoo/xts/ts object
if (!is.null(time(time_series))) {
dates <- as.Date(time(time_series))
} else {
# fallback: weekly sequence ending at today
dates <- seq.Date(Sys.Date() - 7 * (length(y) - 1),
by = "week", length.out = length(y))
}
}
if (length(dates) != length(y))
stop("Length of 'dates' must equal length of 'time_series'")
# 2.  Train-test split index (80/20 by default)
