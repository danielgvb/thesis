df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
colnames(df)
X <- df[c('Latitude', 'Longitude', "tavg", "tmin", "tmax", "prcp", "wdir", "wspd", "pres")]
y <- df[c('count')]
library(gam)
g1 <- gam(count~s(Latitude)+s(Longitude) + s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df)
summary(g1)
