## 1. Load libraries for parallel processing with progress updates ------
# install.packages(c("future", "furrr", "progressr")) # Run once if not installed
library(future)
library(furrr)
library(progressr)
## 2. Set up the parallel environment ------
# Use all cores minus one to keep the computer responsive
n_cores <- availableCores() - 1
plan(multisession, workers = n_cores)
# Configure progressr to display messages in the console
handlers(global = TRUE)
handlers("txtprogressbar")
cat(paste("\n--- Starting PARALLEL tuning to find best k using", n_cores, "cores ---\n"))
## Define candidates and run the parallel tuning loop -------
# Candidate values for k
candidate_k <- c(5, 7, 10, 15, 20)
# The with_progress() function enables the live messaging system
with_progress({
# Create a progressor object that knows the total number of steps
p <- progressor(steps = length(candidate_k))
# future_map_dfr iterates through candidate_k in parallel.
# It combines the resulting one-row data frames into a single result.
aic_results <- future_map_dfr(candidate_k, .f = function(k_val) {
# Send a status message back to the main console
p(message = sprintf("Evaluating k = %d", k_val))
# Define the formula with the current k value
current_formula <- as.formula(
paste0("count ~ te(Longitude, Latitude, k = ", k_val, ") +",
"s(elevation, k = ", k_val, ") + s(tavg, k = ", k_val, ") + s(tmax, k = ", k_val, ") +",
"s(prcp, k = ", k_val, ") + s(wdir, k = ", k_val, ") + s(wspd, k = ", k_val, ") +",
"s(pres, k = ", k_val, ")")
)
# Fit the GAM model on the ENTIRE training dataset
model_fit <- gam(current_formula,
family = poisson,
data = train_data,
method = "REML")
# Extract the AIC
current_aic <- AIC(model_fit)
# Return a one-row tibble for this k_val
return(tibble(k = k_val, AIC = current_aic))
}) # End of future_map_dfr
}) # End of with_progress
