from = st_bbox(train_data)["ymin"],
to = st_bbox(train_data)["ymax"],
length.out = 150
)
)
# Convert the grid to a spatial object and clip it to Colombia's borders
clipped_grid <- prediction_grid %>%
st_as_sf(coords = c("Longitude", "Latitude"), crs = st_crs(country_map)) %>%
st_intersection(country_map)
# Extract the coordinates back into regular columns for plotting
clipped_coords <- st_coordinates(clipped_grid)
clipped_grid$Longitude <- clipped_coords[, "X"]
clipped_grid$Latitude <- clipped_coords[, "Y"]
# --- 8. SETUP THE ANIMATION ------------------------------
# Create a directory to store the animation frames
if (!dir.exists("animation_frames")) {
dir.create("animation_frames")
}
# Define the sequence of weeks for the animation
# This creates 50 evenly spaced weeks from the training data for a smooth video
week_sequence <- round(seq(
from = min(train_data$week_num),
to = max(train_data$week_num),
length.out = 50 # Increase for a smoother, longer video
))
# --- 9. PRE-CALCULATE ALL PREDICTIONS FOR A CONSISTENT SCALE ----------------------------
cat("--- Preparing data for animation ---\n")
# Create a large grid by repeating the spatial coordinates for each week
full_prediction_grid <- tidyr::crossing(
clipped_grid %>% select(Longitude, Latitude, geometry),
week_num = week_sequence
)
# Add the mean values of other covariates from the model
full_prediction_grid$tmax  <- mean(train_data$tmax)
full_prediction_grid$prcp  <- mean(train_data$prcp)
full_prediction_grid$wspd  <- mean(train_data$wspd)
# Predict for all time steps at once
all_effects <- predict(
final_model,
newdata = full_prediction_grid,
type = "terms"
)
# Find the global min and max to use for the color scale limits
effect_range <- range(all_effects[, "te(Longitude,Latitude)"], na.rm = TRUE)
cat("Global effect range for color scale:", round(effect_range, 2), "\n")
# Add the predicted effects and a readable date column to the grid
full_prediction_grid$effect <- all_effects[, "te(Longitude,Latitude)"]
full_prediction_grid <- full_prediction_grid %>%
mutate(week_date = as.Date(week_num, origin = "1970-01-01"))
# --- 10. GENERATE AND SAVE PLOTS IN A LOOP ----------------
cat("--- Starting to generate frames... ---\n")
for (i in 1:length(week_sequence)) {
current_week_num <- week_sequence[i]
# Filter the data for the current week
plot_data <- full_prediction_grid %>%
filter(week_num == current_week_num)
# Get the actual date for the plot title
current_date <- plot_data$week_date[1]
# Create the plot
p <- ggplot() +
geom_raster(data = plot_data, aes(x = Longitude, y = Latitude, fill = effect)) +
geom_sf(data = country_map, fill = NA, color = "black", linewidth = 0.5) +
# Use the pre-calculated effect_range for consistent scale limits
scale_fill_distiller(
palette = "RdBu",
name = "Spatial Effect",
limits = effect_range
) +
coord_sf(crs = st_crs(country_map)) +
# Make the title dynamic to show the current date
labs(
title = "Predicted Spatial Effect of Dengue",
subtitle = paste("Date:", format(current_date, "%Y-%m-%d")),
x = "Longitude",
y = "Latitude"
) +
theme_minimal() +
theme(plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 14))
# Save the plot with a padded number in the filename (e.g., frame_001.png)
file_name <- sprintf("animation_frames/frame_%03d.png", i)
ggsave(file_name, plot = p, width = 8, height = 7, dpi = 150)
# Print progress to the console
cat("Saved:", file_name, "\n")
}
cat("--- Frame generation complete! --- \n")
cat("You can now build the video using FFmpeg.\n")
plot(final_model, scheme = 2)
s(prcp, bs = 'ts') +
s(wspd, bs = 'ps') +
s(week_num, bs = 'ps') +
te(Longitude, Latitude)")
# Fit the final, optimized model
final_model <- gam(final_formula,
family = gaussian(), # change for best model
data = train_data,
method = "REML",
final_formula <- as.formula("count_t1 ~ s(count) + s(tmax, bs = 'tp', k=6) +
s(prcp, bs = 'ts') +
s(wspd, bs = 'ps') +
s(week_num, bs = 'ps') +
te(Longitude, Latitude)")
# Fit the final, optimized model
final_model <- gam(final_formula,
family = gaussian(), # change for best model
data = train_data,
method = "REML",
select = TRUE)
plot(final_model, scheme = 2, pages = 2)
