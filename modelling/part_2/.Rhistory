library(dplyr)
library(mgcv)
library(stringr)
df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
X <- df[c('Latitude', 'Longitude', "tavg", "tmin", "tmax", "prcp", "wdir", "wspd", "pres", "elevation")]
y <- df[c('count')]
df <- df %>%
mutate(
# str_split returns a list, so we use sapply to extract the 2nd element of each split
departamento = sapply(str_split(idx_city, "_"), function(x) x[2])
)
# Train Test Split----------------
# Set a seed for reproducibility, so you always get the same split
set.seed(42)
# 1. Get a list of all unique departments in your dataset
all_deps <- unique(df$departamento)
cat("Total number of departments found:", length(all_deps), "\n")
# 2. Determine the number of departments to select for the test set (20%)
test_size_deps <- floor(0.20 * length(all_deps))
cat("Number of departments for test set:", test_size_deps, "\n")
# 3. Randomly sample the names of the departments for the test set
test_departamentos <- sample(all_deps, size = test_size_deps)
cat("\nDepartments selected for the test set:\n")
print(test_departamentos)
# 4. Create the training and testing data frames
train_data <- df %>%
filter(!departamento %in% test_departamentos)
test_data <- df %>%
filter(departamento %in% test_departamentos)
# 5. Verify the split
cat("\n--- Data Split Summary ---\n")
cat("Total rows in original data:", nrow(df), "\n")
cat("Rows in training data:", nrow(train_data), "(from", n_distinct(train_data$departamento), "departments)\n")
cat("Rows in testing data:", nrow(test_data), "(from", n_distinct(test_data$departamento), "departments)\n")
# 1. Define the names of your predictor columns and the response column
predictor_cols <- c('Latitude', 'Longitude', "tavg", "tmin", "tmax",
"prcp", "wdir", "wspd", "pres", "elevation")
response_col <- 'count'
# 2. Create the training sets (X_train, y_train)
# Select only the predictor columns from the training data
X_train <- train_data[, predictor_cols]
# Select the single response column from the training data
y_train <- train_data[, response_col]
# 3. Create the testing sets (X_test, y_test)
# Select only the predictor columns from the testing data
X_test <- test_data[, predictor_cols]
# Select the single response column from the testing data
y_test <- test_data[, response_col]
# 4. Verify the dimensions of your new objects
cat("--- Training Set Dimensions ---\n")
cat("X_train:", dim(X_train)[1], "rows,", dim(X_train)[2], "columns\n")
cat("y_train:", length(y_train), "values\n")
cat("\n--- Testing Set Dimensions ---\n")
cat("X_test:", dim(X_test)[1], "rows,", dim(X_test)[2], "columns\n")
cat("y_test:", length(y_test), "values\n")
cat("\n--- First few rows of X_train ---\n")
print(head(X_train))
cat("\n--- First few values of y_train ---\n")
print(head(y_train))
install.packages(c("sf", "spatialsample"))
library(sf)
library(spatialsample)
# This code assumes 'train_data' exists from your previous split by departamento
# If it's not an sf object, convert it first.
if (!inherits(train_data, "sf")) {
train_data <- st_as_sf(train_data, coords = c("Longitude", "Latitude"), crs = 4326)
}
# Create 5 spatial cross-validation folds from the training data
# This divides the training data into 5 geographic "blocks" for testing
set.seed(123) # for reproducibility
cv_folds <- spatial_block_cv(train_data, v = 5)
cat("Created 5 spatial cross-validation folds from the training data.\n")
# Candidate values for k (your original list)
candidate_k <- c(5, 7, 10, 15, 20)
# Create a data frame to store the results
cv_results <- data.frame(k = integer(), mean_rmse = double(), sd_rmse = double())
cat("Starting cross-validation to find the best k...\n\n")
# ---- Outer loop: Iterate through each candidate k ----
for (k_val in candidate_k) {
cat(paste0("--- Evaluating k = ", k_val, " ---\n"))
fold_rmse_scores <- c() # Store RMSE for each fold here
# ---- Inner loop: Iterate through each of the 5 CV folds ----
for (i in 1:nrow(cv_folds)) {
# 1. Get the training and validation sets for this specific fold
analysis_set <- training(cv_folds$splits[[i]])
assessment_set <- testing(cv_folds$splits[[i]])
# 2. Fit the GAM model on the 'analysis' (training) part of the fold
# Using 'try()' to prevent one bad fold from stopping the whole loop
model_fit <- try(
gam(count ~ te(Longitude, Latitude, k = k_val) +
s(elevation, k = k_val) +
s(tavg, k = k_val) +
s(tmax, k = k_val) +
s(prcp, k = k_val) +
s(wdir, k = k_val) +
s(wspd, k = k_val) +
s(pres, k = k_val),
family = poisson,
data = analysis_set,
method = "REML")
)
if (inherits(model_fit, "try-error")) {
cat(paste0("    Fold ", i, ": Failed to fit model. Skipping.\n"))
next # Skip to the next fold
}
# 3. Predict on the 'assessment' (validation) part of the fold
predictions <- predict(model_fit, newdata = assessment_set, type = "response")
actuals <- assessment_set$count
# 4. Calculate RMSE and store it
fold_rmse <- sqrt(mean((predictions - actuals)^2))
fold_rmse_scores <- c(fold_rmse_scores, fold_rmse)
cat(paste0("    Fold ", i, " RMSE: ", round(fold_rmse, 3), "\n"))
}
# 5. Calculate the average RMSE across all folds for the current k
mean_k_rmse <- mean(fold_rmse_scores, na.rm = TRUE)
sd_k_rmse <- sd(fold_rmse_scores, na.rm = TRUE)
cat(paste0("  -> Average RMSE for k = ", k_val, ": ", round(mean_k_rmse, 3), "\n\n"))
# 6. Store the results
cv_results <- rbind(cv_results, data.frame(k = k_val, mean_rmse = mean_k_rmse, sd_rmse = sd_k_rmse))
}
# ---- Outer loop: Iterate through each candidate k ----
for (k_val in candidate_k) {
cat(paste0("--- Evaluating k = ", k_val, " ---\n"))
fold_rmse_scores <- c() # Store RMSE for each fold here
# ---- Inner loop: Iterate through each of the 5 CV folds ----
for (i in 1:nrow(cv_folds)) {
# 1. Get the training and validation sets for this specific fold
analysis_set <- training(cv_folds$splits[[i]])
assessment_set <- testing(cv_folds$splits[[i]])
# 2. Fit the GAM model on the 'analysis' (training) part of the fold
# Using 'try()' to prevent one bad fold from stopping the whole loop
model_fit <- try(
gam(count ~ te(Longitude, Latitude, k = k_val) +
s(elevation, k = k_val) +
s(tavg, k = k_val) +
s(tmax, k = k_val) +
s(prcp, k = k_val) +
s(wdir, k = k_val) +
s(wspd, k = k_val) +
s(pres, k = k_val),
family = poisson,
data = analysis_set,
method = "REML")
)
if (inherits(model_fit, "try-error")) {
cat(paste0("    Fold ", i, ": Failed to fit model. Skipping.\n"))
next # Skip to the next fold
}
# 3. Predict on the 'assessment' (validation) part of the fold
predictions <- predict(model_fit, newdata = assessment_set, type = "response")
actuals <- assessment_set$count
# 4. Calculate RMSE and store it
fold_rmse <- sqrt(mean((predictions - actuals)^2))
fold_rmse_scores <- c(fold_rmse_scores, fold_rmse)
cat(paste0("    Fold ", i, " RMSE: ", round(fold_rmse, 3), "\n"))
}
# 5. Calculate the average RMSE across all folds for the current k
mean_k_rmse <- mean(fold_rmse_scores, na.rm = TRUE)
sd_k_rmse <- sd(fold_rmse_scores, na.rm = TRUE)
cat(paste0("  -> Average RMSE for k = ", k_val, ": ", round(mean_k_rmse, 3), "\n\n"))
# 6. Store the results
cv_results <- rbind(cv_results, data.frame(k = k_val, mean_rmse = mean_k_rmse, sd_rmse = sd_k_rmse))
}
library(rsample) # <--- THIS IS THE FIX. Load the rsample package.
# 1. Load all required libraries ------------
# Data manipulation
library(dplyr)
library(stringr)
library(tidyr)
# Spatial analysis
library(sf)
library(spatialsample)
library(rsample)
# Modeling
library(mgcv)
# 2. Define key parameters -------------
# File path for the dataset
FILE_PATH <- "~/GitHub/thesis/Data/platinum/dengue_weather.csv"
# Proportion of departments to use for the final test set
TEST_PROPORTION <- 0.20
# Candidate k-values for hyperparameter tuning
CANDIDATE_K <- c(5, 7, 10, 15, 20)
# Number of folds for cross-validation
CV_FOLDS <- 5
# Set a seed for all random processes for reproducibility
set.seed(42)
cat("--- Loading and pre-processing data ---\n")
# Load the raw data
full_df <- read.csv(FILE_PATH)
# Create 'departamento' column and convert to a spatial 'sf' object
# The coordinate system (CRS) 4326 is standard for Latitude/Longitude data.
full_sf <- full_df %>%
mutate(
departamento = str_split_i(idx_city, "_", 2) # More direct way to get the 2nd element
) %>%
st_as_sf(coords = c("Longitude", "Latitude"), crs = 4326, remove = FALSE)
cat("Data loaded and converted to spatial object.\n")
cat("\n--- Creating train-test split based on departments ---\n")
# Get unique departments and sample them for the test set
all_deps <- unique(full_sf$departamento)
test_departamentos <- sample(all_deps, size = floor(TEST_PROPORTION * length(all_deps)))
# Create the training and testing sets
train_data <- full_sf %>% filter(!departamento %in% test_departamentos)
test_data  <- full_sf %>% filter(departamento %in% test_departamentos)
# Report summary of the split
cat("Split complete:\n")
cat("  - Training data:", nrow(train_data), "rows from", n_distinct(train_data$departamento), "departments.\n")
cat("  - Testing data: ", nrow(test_data), "rows from", n_distinct(test_data$departamento), "departments.\n")
cat("\n--- Setting up for hyperparameter tuning using spatial CV ---\n")
# Create spatial cross-validation folds from the training data
cv_folds <- spatial_block_cv(train_data, v = CV_FOLDS)
cat(paste("Created", CV_FOLDS, "spatial cross-validation folds.\n"))
# Define the GAM formula once to avoid repeating it
gam_formula <- as.formula(
count ~ te(Longitude, Latitude, k = k_val) +
s(elevation, k = k_val) + s(tavg, k = k_val) + s(tmax, k = k_val) +
s(prcp, k = k_val) + s(wdir, k = k_val) + s(wspd, k = k_val) +
s(pres, k = k_val)
)
# Data frame to store tuning results
cv_results <- tibble(k = integer(), mean_rmse = double(), sd_rmse = double())
cat("\n--- Starting cross-validation to find the best k ---\n")
# Loop through each candidate k
for (k_val in CANDIDATE_K) {
fold_rmse_scores <- c()
cat(paste0("--- Evaluating k = ", k_val, " ---\n"))
# Loop through each CV fold
for (i in 1:CV_FOLDS) {
analysis_set <- training(cv_folds$splits[[i]])
assessment_set <- testing(cv_folds$splits[[i]])
# Fit the model on the analysis set
model_fit <- gam(gam_formula, family = poisson, data = analysis_set, method = "REML")
# Predict on the assessment set and calculate RMSE
predictions <- predict(model_fit, newdata = assessment_set, type = "response")
fold_rmse <- sqrt(mean((predictions - assessment_set$count)^2))
fold_rmse_scores <- c(fold_rmse_scores, fold_rmse)
}
# Store the average performance for this k
cv_results <- cv_results %>%
add_row(k = k_val, mean_rmse = mean(fold_rmse_scores), sd_rmse = sd(fold_rmse_scores))
