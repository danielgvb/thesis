for (k_val in candidate_k) {
cat(paste0("--- Evaluating k = ", k_val, " ---\n"))
# Define the formula with the current k value
current_formula <- as.formula(
paste0("count ~ te(Longitude, Latitude, k = ", k_val, ") +",
"s(elevation, k = ", k_val, ") + s(tavg, k = ", k_val, ") + s(tmax, k = ", k_val, ") +",
"s(prcp, k = ", k_val, ") + s(wdir, k = ", k_val, ") + s(wspd, k = ", k_val, ") +",
"s(pres, k = ", k_val, ")")
)
# Fit the GAM model on the ENTIRE training dataset
model_fit <- gam(current_formula,
family = poisson,
data = train_data,
method = "REML")
# Extract the AIC and store it
current_aic <- AIC(model_fit)
aic_results <- aic_results %>% add_row(k = k_val, AIC = current_aic)
cat(paste0("  -> AIC for k = ", k_val, ": ", round(current_aic, 2), "\n"))
}
cat("\n--- Starting PARALLEL tuning to find the best k using AIC ---\n")
## ADDED FOR PARALLEL COMPUTING: Load required packages
library(future)
library(furrr)
## ADDED FOR PARALLEL COMPUTING: Set up parallel workers
# Use all cores minus one to keep the computer responsive
n_cores <- availableCores() - 1
plan(multisession, workers = n_cores)
cat(paste("Parallel processing activated using", n_cores, "cores.\n"))
# 1. Define candidates
# Candidate values for k
candidate_k <- c(5, 7, 10, 15, 20)
# 2. Loop through each candidate k in parallel, fit on all training data, and get AIC
# We replace the for-loop with `future_map_dfr` which iterates in parallel
# and combines the resulting data frames by rows (`dfr`).
aic_results <- future_map_dfr(candidate_k, .progress = TRUE, .options = furrr_options(seed=TRUE), .f = function(k_val) {
# The code inside this function runs on a separate core for each k_val.
# The cat() statements are removed as they don't print nicely from parallel workers.
# The .progress = TRUE argument gives you a progress bar instead.
# Define the formula with the current k value
current_formula <- as.formula(
paste0("count ~ te(Longitude, Latitude, k = ", k_val, ") +",
"s(elevation, k = ", k_val, ") + s(tavg, k = ", k_val, ") + s(tmax, k = ", k_val, ") +",
"s(prcp, k = ", k_val, ") + s(wdir, k = ", k_val, ") + s(wspd, k = ", k_val, ") +",
"s(pres, k = ", k_val, ")")
)
# Fit the GAM model on the ENTIRE training dataset
model_fit <- gam(current_formula,
family = poisson,
data = train_data,
method = "REML")
# Extract the AIC
current_aic <- AIC(model_fit)
# Return a one-row tibble. `future_map_dfr` will combine these into one data frame.
return(tibble(k = k_val, AIC = current_aic))
})
