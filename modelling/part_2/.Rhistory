# GAM
# import packages
library(dplyr)
library(mgcv)
df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
m1 <- gam(s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df)
m1 <- gam(count~s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df)
summary(m1)
plot(m1,pages=1,residuals=TRUE) ## show partial residuals
plot(m1,pages=2,residuals=TRUE) ## show partial residuals
plot(m1,pages=1,seWithMean=TRUE) ## `with intercept' CIs
## run some basic model checks, including checking
## smoothing basis dimensions...
gam.check(m1)
## change the smoothness selection method to REML
b0 <- gam(count~s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df, method="REML")
## use alternative plotting scheme, and way intervals include
## smoothing parameter uncertainty...
plot(b0,pages=1,scheme=1,unconditional=TRUE)
## use alternative plotting scheme, and way intervals include
## smoothing parameter uncertainty...
plot(b0,pages=1,scheme=1,unconditional=TRUE, scale = 0)
## Would a smooth interaction of Latitude and Longitude be better?
## Use tensor product smooth of x0 and x1, basis
## dimension 49 (see ?te for details, also ?t2).
bt <- gam(count~te(Latitude,Longitude,k=7) + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson,,data=df,
method="REML")
plot(bt,pages=1, scale = 0)
df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
## Would a smooth interaction of Latitude and Longitude be better?
## Use tensor product smooth of x0 and x1, basis
## dimension 49 (see ?te for details, also ?t2).
bt <- gam(count~te(Latitude,Longitude,k=7) + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson,,data=df,
method="REML")
df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
## change the smoothness selection method to REML
b0 <- gam(count~s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df, method="REML")
## Would a smooth interaction of Latitude and Longitude be better?
## Use tensor product smooth of x0 and x1, basis
## dimension 49 (see ?te for details, also ?t2).
bt <- gam(count~te(Latitude,Longitude,k=7) + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson,,data=df,
method="REML")
plot(bt,pages=3, scale = 0)
plot(bt,pages=2,scheme=2, scale = 0) ## alternative visualization
## Use tensor product smooth of x0 and x1, basis
## dimension 49 (see ?te for details, also ?t2).
bt <- gam(count~te(Longitude,Latitude,k=7) + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson,,data=df,
method="REML")
plot(bt,pages=2,scheme=2, scale = 0) ## alternative visualization
AIC(b0,bt) ## interaction worse than additive
gam.check(bt)
# Automated loop to select optimal `k` using AIC
# Candidate values for k
candidate_k <- c(5, 7, 10, 15, 20)
# Function to systematically evaluate AIC for different k
evaluate_aic <- function(k_val, data) {
mod <- gam(count ~ te(Longitude, Latitude, k = k_val) +
s(elevation, k = k_val) +
s(tavg, k = k_val) +
s(tmax, k = k_val) +
s(prcp, k = k_val) +
s(wdir, k = k_val) +
s(wspd, k = k_val) +
s(pres, k = k_val),
family = poisson, data = data, method = "REML")
return(AIC(mod))
}
# Evaluate models systematically
aic_results <- sapply(candidate_k, evaluate_aic, data = df)
aic_results
# Inspect AIC values
aic_df <- data.frame(k = candidate_k, AIC = aic_results)
print(aic_df)
# Select optimal k
optimal_k <- aic_df$k[which.min(aic_df$AIC)]
cat("Optimal k selected:", optimal_k)
final_mod <- gam(count ~ te(Longitude, Latitude, k = optimal_k) +
s(elevation, k = optimal_k) +
s(tavg, k = optimal_k) +
s(tmax, k = optimal_k) +
s(prcp, k = optimal_k) +
s(wdir, k = optimal_k) +
s(wspd, k = optimal_k) +
s(pres, k = optimal_k),
family = poisson, data = data, method = "REML")
final_mod <- gam(count ~ te(Longitude, Latitude, k = optimal_k) +
s(elevation, k = optimal_k) +
s(tavg, k = optimal_k) +
s(tmax, k = optimal_k) +
s(prcp, k = optimal_k) +
s(wdir, k = optimal_k) +
s(wspd, k = optimal_k) +
s(pres, k = optimal_k),
family = poisson, data = df, method = "REML")
plot(final_mod,pages=2,scheme=2, scale = 0) ## alternative visualization
# Define your response and covariates
response <- "count"
covariates <- c("elevation", "tavg", "tmax", "prcp", "wdir", "wspd", "pres")
# Candidate smoothing bases
bases <- c("tp", "cr", "cs", "ps", "ts")
# Store best bases
best_bases <- list()
# Loop through covariates individually, choosing best smoothing basis per covariate
for(var in covariates){
aic_vals <- c()
for(b in bases){
# Construct the model formula dynamically
formula_str <- paste0(response, "~ te(Longitude, Latitude, k=7) + ")
formula_str <- paste0(formula_str, paste0("s(", var, ", bs='", b, "') + "))
# Add other variables with default "tp"
other_vars <- covariates[covariates != var]
formula_str <- paste0(formula_str, paste0("s(", other_vars, ", bs='tp')", collapse=" + "))
# Fit the GAM with REML or ML for AIC comparison (REML is default but use ML for strict AIC optimization)
mod <- gam(as.formula(formula_str), family=poisson, data=df, method="ML")
# Save AIC
aic_vals[b] <- AIC(mod)
}
# Select basis with lowest AIC
best_basis <- names(which.min(aic_vals))
best_bases[[var]] <- best_basis
}
# Display the selected best basis per variable
print(best_bases)
# Fit final GAM using optimal smoothing basis per covariate
final_formula_str <- paste0(response, "~ te(Longitude, Latitude, k=7) + ")
final_formula_str <- paste0(final_formula_str, paste0("s(", covariates, ", bs='", best_bases, "')", collapse=" + "))
final_gam <- gam(as.formula(final_formula_str), family=poisson, data=df, method="REML")
# Check final model
summary(final_gam)
AIC(final_gam)
AIC(final_gam, final_mod)
plot(final_gam,pages=2,scheme=2, scale = 0) ## alternative visualization
# GAM
# import packages
library(dplyr)
library(mgcv)
df <- read.csv("~/GitHub/thesis/Data/platinum/dengue_weather.csv")
m1 <- gam(count~s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df)
summary(m1)
plot(m1,pages=1,seWithMean=TRUE, scale = 0) ## `with intercept' CIs
## run some basic model checks, including checking
## smoothing basis dimensions...
gam.check(m1)
## change the smoothness selection method to REML
b0 <- gam(count~s(Latitude)+s(Longitude)  + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson, data = df, method="REML")
## use alternative plotting scheme, and way intervals include
## smoothing parameter uncertainty...
plot(b0,pages=1,scheme=1,unconditional=TRUE, scale = 0)
## Would a smooth interaction of Latitude and Longitude be better?
## Use tensor product smooth of x0 and x1, basis
## dimension 49 (see ?te for details, also ?t2).
bt <- gam(count~te(Longitude,Latitude,k=7) + s(elevation)+ s(tavg) + s(tmax) + s(prcp) +
s(wdir) + s(wspd) + s(pres), family = poisson,,data=df,
method="REML")
plot(bt,pages=2, scale = 0)
summary(bt)
plot(bt,pages=2,scheme=2, scale = 0) ## alternative visualization
AIC(b0,bt) ## interaction better than additive
gam.check(bt)
# Loop degrees freedom--------------
# Automated loop to select optimal `k` using AIC
# Candidate values for k
candidate_k <- c(5, 7, 10, 15, 20)
# Function to systematically evaluate AIC for different k
evaluate_aic <- function(k_val, data) {
mod <- gam(count ~ te(Longitude, Latitude, k = k_val) +
s(elevation, k = k_val) +
s(tavg, k = k_val) +
s(tmax, k = k_val) +
s(prcp, k = k_val) +
s(wdir, k = k_val) +
s(wspd, k = k_val) +
s(pres, k = k_val),
family = poisson, data = data, method = "REML")
return(AIC(mod))
}
# Evaluate models systematically
aic_results <- sapply(candidate_k, evaluate_aic, data = df)
aic_results
# Inspect AIC values
aic_df <- data.frame(k = candidate_k, AIC = aic_results)
print(aic_df)
# Select optimal k
optimal_k <- aic_df$k[which.min(aic_df$AIC)]
cat("Optimal k selected:", optimal_k)
final_mod <- gam(count ~ te(Longitude, Latitude, k = optimal_k) +
s(elevation, k = optimal_k) +
s(tavg, k = optimal_k) +
s(tmax, k = optimal_k) +
s(prcp, k = optimal_k) +
s(wdir, k = optimal_k) +
s(wspd, k = optimal_k) +
s(pres, k = optimal_k),
family = poisson, data = df, method = "REML")
plot(final_mod,pages=2,scheme=2, scale = 0) ## alternative visualization
View(df)
plot(final_mod,pages=2,scheme=2, scale = 0) ## alternative visualization
summary(final_mod)
