arima_plot <- ggplot(df_plot, aes(x = Time)) +
geom_line(aes(y = Actual, color = "Actual"), size = 1) +
geom_line(aes(y = Fitted, color = "Fitted"), linetype = "dashed", size = 1) +
scale_color_manual(values = c("Actual" = "black", "Fitted" = "red")) +
labs(color = "Legend") +  # Legend title
ggtitle("ARIMA Model for Cumulative Cases") +
ylab("Cumulative Cases") +
xlab("Time") +
theme_minimal() +
theme(
text = element_text(size = 8),
axis.text = element_text(size = 8),
axis.title = element_text(size = 8),
plot.title = element_text(size = 10),
legend.text = element_text(size = 8),
legend.title = element_text(size = 8),
plot.margin = unit(c(0.1, 0.1, 0.1, 0.1), "cm")
)
return(list(plot = arima_plot, result = data.frame(rmse = rmse, r2 = r2)))
}, error = function(e) {
print(paste("Error processing dataframe:", e$message))
return(NULL)
})
}
# Function to evaluate multiple datasets and display plots in a 2x2 grid
evaluate_multiple_epidemics <- function(dfs, train_ratio = 1.0) {
results_list <- lapply(dfs, function(df) evaluate_arima_epidemics(df, train_ratio))
# Extract plots and results
plot_list <- lapply(results_list, function(res) res$plot)
results_df <- do.call(rbind, lapply(results_list, function(res) res$result))
# Display plots in a 2x2 grid
grid.arrange(grobs = plot_list, nrow = 2, ncol = 2)
# Return the results dataframe
return(results_df)
}
results_df <- evaluate_multiple_epidemics(dfs, train_ratio = 1.0)
print(results_df)
results_df <- evaluate_multiple_epidemics(dfs, train_ratio = 0.8)
# Function to evaluate ARIMA for a single dataframe
evaluate_arima_epidemic <- function(df, name) {
tryCatch({
# Ensure time series is ordered
df <- df[order(rownames(df)), ]
# Extract the cumulative_cases column
series <- ts(df$cumulative_cases, frequency = 1)
# Fit ARIMA model
model <- auto.arima(series)
fitted_values <- fitted(model)
# Calculate RMSE and R-squared
rmse <- sqrt(mean((series - fitted_values)^2))
r2 <- 1 - sum((series - fitted_values)^2) / sum((series - mean(series))^2)
# Prepare data for ggplot
df_plot <- data.frame(Time = 1:length(series), Actual = series, Fitted = fitted_values)
# Create ggplot
p <- ggplot(df_plot, aes(x = Time)) +
geom_line(aes(y = Actual, color = "Actual"), size = 1) +
geom_line(aes(y = Fitted, color = "Fitted"), linetype = "dashed", size = 1) +
scale_color_manual(values = c("Actual" = "black", "Fitted" = "red")) +
labs(color = "Legend") +
ggtitle(paste("ARIMA Fit for", name)) +
ylab("Cumulative Cases") +
xlab("Time") +
theme_minimal()
return(list(plot = p, result = data.frame(name = name, rmse = rmse, r2 = r2)))
}, error = function(e) {
print(paste("Error processing", name, ":", e$message))
return(NULL)
})
}
# Function to evaluate ARIMA for multiple dataframes
evaluate_arima_multiple <- function(dfs, names) {
results <- list()
plots <- list()
for (i in seq_along(dfs)) {
result <- evaluate_arima_epidemics(dfs[[i]], names[i])
if (!is.null(result)) {
results[[i]] <- result$result
plots[[i]] <- result$plot
}
}
# Combine results into a dataframe
results_df <- do.call(rbind, results)
# Arrange plots in a grid
grid_plot <- cowplot::plot_grid(plotlist = plots, ncol = ceiling(length(dfs) / 2))
return(list(grid_plot = grid_plot, results_df = results_df))
}
evaluate_arima_multiple(dfs, c('Dengue', 'Zika', 'Chikungunya', 'Chickenpox'))
