# Function to evaluate ARIMA with train-test split
evaluate_arima_epidemic_split <- function(df, name, train_ratio = 0.8) {
tryCatch({
# Ensure time series is ordered by date
df <- df[order(df$date), ]
# Extract the cumulative_cases column
series <- ts(df$cumulative_cases, frequency = 1)
# Split into train and test sets
train_size <- floor(train_ratio * length(series))
train_series <- ts(series[1:train_size], frequency = 1)
test_series <- ts(series[(train_size + 1):length(series)], frequency = 1)
# Fit ARIMA model on the training set
model <- auto.arima(train_series)
fitted_values_train <- fitted(model)
# Forecast on the test set
forecast_values <- forecast(model, h = length(test_series))$mean
# Combine fitted and forecasted values
fitted_values_full <- c(fitted_values_train, forecast_values)
# Calculate RMSE and R-squared on the test set
rmse <- sqrt(mean((test_series - forecast_values)^2))
r2 <- 1 - sum((test_series - forecast_values)^2) / sum((test_series - mean(test_series))^2)
# Prepare data for ggplot
df_plot <- data.frame(
Time = 1:length(series),
Actual = series,
Fitted = fitted_values_full
)
# Create ggplot
p <- ggplot(df_plot, aes(x = Time)) +
geom_line(aes(y = Actual, color = "Actual"), size = 1) +
geom_line(aes(y = Fitted, color = "Fitted"), linetype = "dashed", size = 1) +
geom_vline(xintercept = train_size, linetype = "dotted", color = "blue", size = 1) +
scale_color_manual(values = c("Actual" = "black", "Fitted" = "red")) +
labs(color = "Legend") +
ggtitle(paste("ARIMA Fit with Train-Test Split for", name)) +
ylab("Cumulative Cases") +
xlab("Time") +
theme_minimal()
return(list(plot = p, result = data.frame(name = name, rmse = rmse, r2 = r2)))
}, error = function(e) {
print(paste("Error processing", name, ":", e$message))
return(NULL)
})
}
# Function to evaluate ARIMA with train-test split for multiple dataframes
evaluate_arima_multiple_split <- function(dfs, names, train_ratio = 0.8) {
results <- list()
plots <- list()
for (i in seq_along(dfs)) {
result <- evaluate_arima_epidemic_split(dfs[[i]], names[i], train_ratio)
if (!is.null(result)) {
results[[i]] <- result$result
plots[[i]] <- result$plot
}
}
# Combine results into a dataframe
if (length(results) > 0) {
results_df <- do.call(rbind, results)
} else {
results_df <- data.frame()
}
# Arrange plots in a grid
if (length(plots) > 0) {
grid_plot <- cowplot::plot_grid(plotlist = plots, ncol = ceiling(length(dfs) / 2))
} else {
grid_plot <- NULL
}
return(list(grid_plot = grid_plot, results_df = results_df))
}
result_split <- evaluate_arima_multiple_split(dfs, c('Dengue', 'Zika', 'Chikungunya', 'Chickenpox'), train_ratio = 0.8)
print(result_split$results_df)  # Check the RMSE and R² values
print(result_split$grid_plot)   # Display the grid plot
